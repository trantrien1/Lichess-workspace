--- /dev/null
+++ b/ui/round/src/view/winProbability.ts
@@ -0,0 +1,73 @@
+import { hl, type LooseVNode } from 'lib/view/snabbdom';
+
+import type RoundController from '../ctrl';
+import { wdlPercentages } from '../winProbability';
+
+export default function winProbability(ctrl: RoundController): LooseVNode {
+  if (!ctrl.winProbability) return undefined;
+  const prediction = ctrl.winProbability.data;
+  const replay = ctrl.replaying();
+  const ready = !replay && (prediction?.status === 'ready' || prediction?.status === 'finished');
+  const human =
+    ready && prediction.source === 'engine' && prediction.human?.status === 'ready'
+      ? prediction.human
+      : undefined;
+  const p = ready && (human?.probabilities ?? prediction.probabilities);
+  const values = p && wdlPercentages(p);
+  const source = prediction?.source === 'official' ? 'official' : human?.probabilities ? 'human' : 'engine';
+  const label =
+    source === 'official'
+      ? 'Kết quả chính thức'
+      : source === 'human'
+        ? 'Người chơi · thử nghiệm'
+        : 'Ước tính từ thế cờ';
+  const description =
+    source === 'official'
+      ? 'Kết quả ván đấu đã được xác nhận.'
+      : source === 'human'
+        ? 'Ước tính từ thế cờ, rating và đồng hồ. Mô hình thử nghiệm, chưa hiệu chỉnh cho cộng đồng máy chủ này.'
+        : 'Xác suất theo engine từ thế cờ; không xét rating và đồng hồ của người chơi.';
+  const status = replay
+    ? 'Trở về nước mới nhất để xem xác suất.'
+    : prediction?.status === 'stale'
+      ? 'Mất kết nối · đang chờ thế cờ mới nhất.'
+      : prediction?.status === 'aborted'
+        ? 'Ván đã hủy · không có kết quả.'
+        : prediction?.status === 'unavailable'
+          ? 'Tạm thời chưa có đánh giá.'
+          : prediction?.status === 'busy'
+            ? 'Đang chờ đánh giá…'
+            : 'Đang tính…';
+  return hl(
+    'section.win-probability',
+    {
+      attrs: {
+        'aria-label': 'Xác suất thắng, hòa, thua',
+        'data-state': replay ? 'replay' : (prediction?.status ?? 'pending'),
+        'data-source': values ? source : false,
+        'data-model': values && human ? (human.model_id ?? false) : false,
+      },
+    },
+    [
+      values
+        ? [
+            hl(
+              'div.win-probability__bar',
+              { attrs: { 'aria-hidden': 'true' } },
+              ['white', 'draw', 'black'].map((color, i) =>
+                hl(`span.win-probability__${color}`, {
+                  attrs: { style: `width:${values[i]}%` },
+                }),
+              ),
+            ),
+            hl(
+              'div.win-probability__values',
+              { attrs: { 'aria-live': 'polite' } },
+              ['Trắng', 'Hòa', 'Đen'].map((color, i) => hl('span', `${color} ${values[i].toFixed(1)}%`)),
+            ),
+            hl('div.win-probability__source', { attrs: { title: description } }, label),
+          ]
+        : hl('div.win-probability__status', { attrs: { role: 'status' } }, status),
+    ],
+  );
+}
diff --git a/ui/round/src/winProbability.ts b/ui/round/src/winProbability.ts
new file mode 100644
index 0000000..1b266f8
--- /dev/null
+++ b/ui/round/src/winProbability.ts
@@ -0,0 +1,179 @@
+import type { RoundData } from './interfaces';
+
+export interface Wdl {
+  white: number;
+  draw: number;
+  black: number;
+}
+
+export interface Prediction {
+  game_id: string;
+  revision: string;
+  status: 'pending' | 'ready' | 'finished' | 'aborted' | 'unavailable' | 'busy' | 'stale';
+  probabilities?: Wdl;
+  source: 'engine' | 'official';
+  engine?: string;
+  depth?: number;
+  human?: {
+    status: 'ready' | 'unavailable';
+    probabilities?: Wdl;
+    model_id?: string;
+    reason?:
+      | 'missing_context'
+      | 'outside_scope'
+      | 'model_unavailable'
+      | 'score_unavailable'
+      | 'invalid_response';
+  };
+}
+
+// History + result, not ply alone: a takeback followed by a different move can reuse a ply.
+export const wdlRevision = (d: RoundData): string =>
+  `${d.game.id}|${d.steps
+    .map(s => s.san)
+    .filter(Boolean)
+    .join(' ')}|${d.game.status.id}|${d.game.winner ?? ''}`;
+
+export function validWdl(p?: Wdl): p is Wdl {
+  if (!p) return false;
+  const values = [p.white, p.draw, p.black];
+  return (
+    values.every(x => Number.isFinite(x) && x >= 0 && x <= 1) &&
+    Math.abs(values.reduce((a, b) => a + b, 0) - 1) < 0.00001
+  );
+}
+
+// Largest-remainder rounding keeps the three displayed percentages at exactly 100.0%.
+export function wdlPercentages(p: Wdl): number[] {
+  const raw = [p.white, p.draw, p.black].map(x => x * 1000);
+  const rounded = raw.map(Math.floor);
+  const order = [0, 1, 2].sort((a, b) => raw[b] - rounded[b] - (raw[a] - rounded[a]));
+  const missing = 1000 - rounded.reduce((a, b) => a + b, 0);
+  for (let i = 0; i < missing; i++) rounded[order[i]]++;
+  return rounded.map(x => x / 10);
+}
+
+export default class WinProbability {
+  data?: Prediction;
+  private revision = '';
+  private timer?: ReturnType<typeof setTimeout>;
+  private request?: AbortController;
+
+  constructor(
+    private readonly round: () => RoundData,
+    private readonly redraw: () => void,
+  ) {
+    document.addEventListener('visibilitychange', this.visibility);
+    this.sync();
+  }
+
+  sync = (): void => {
+    const d = this.round();
+    const revision = wdlRevision(d);
+    if (revision === this.revision) return;
+    this.cancel();
+    this.revision = revision;
+    this.data = undefined;
+    if (d.game.status.id >= 25) {
+      this.data = {
+        game_id: d.game.id,
+        revision,
+        status: d.game.status.id === 25 ? 'aborted' : 'finished',
+        source: 'official',
+        probabilities:
+          d.game.status.id === 25
+            ? undefined
+            : {
+                white: Number(d.game.winner === 'white'),
+                draw: Number(!d.game.winner),
+                black: Number(d.game.winner === 'black'),
+              },
+      };
+    } else if (!document.hidden) void this.load();
+  };
+
+  destroy = (): void => {
+    this.cancel();
+    document.removeEventListener('visibilitychange', this.visibility);
+  };
+
+  disconnected = (): void => {
+    if (this.data?.source === 'official') return;
+    this.cancel();
+    this.data = { game_id: this.round().game.id, revision: this.revision, status: 'stale', source: 'engine' };
+    this.revision = '';
+    this.redraw();
+  };
+
+  private cancel(): void {
+    clearTimeout(this.timer);
+    const request = this.request;
+    this.request = undefined;
+    request?.abort();
+  }
+
+  private readonly visibility = (): void => {
+    if (document.hidden) this.cancel();
+    else if (!this.data || ['pending', 'busy', 'unavailable'].includes(this.data.status)) void this.load();
+  };
+
+  private async load(): Promise<void> {
+    const revision = this.revision;
+    const gameId = this.round().game.id;
+    const request = (this.request = new AbortController());
+    const timeout = setTimeout(() => request.abort(), 1500);
+    let retry = 2000;
+    try {
+      const response = await fetch(`/game/${gameId}/win-probability`, {
+        signal: request.signal,
+        credentials: 'same-origin',
+        cache: 'no-store',
+        headers: { Accept: 'application/json' },
+      });
+      if (this.request !== request || this.revision !== revision) return;
+      if (response.status === 403 || response.status === 404) {
+        this.data = { game_id: gameId, revision, status: 'unavailable', source: 'engine' };
+        retry = 0;
+      } else {
+        if (!response.ok) throw new Error('WDL service unavailable');
+        const data: Prediction = await response.json();
+        if (this.request !== request || this.revision !== revision) return;
+        if (data.game_id !== gameId || data.revision !== revision) {
+          retry = 200;
+        } else {
+          if (['ready', 'finished'].includes(data.status) && !validWdl(data.probabilities))
+            throw new Error('Invalid WDL');
+          if (!['pending', 'ready', 'finished', 'aborted', 'unavailable', 'busy'].includes(data.status))
+            throw new Error('Invalid WDL status');
+          if (data.human) {
+            if (
+              data.human.status === 'ready' &&
+              validWdl(data.human.probabilities) &&
+              typeof data.human.model_id === 'string' &&
+              data.human.model_id.length > 0
+            ) {
+              // The human estimate is optional; malformed data must not hide valid engine WDL.
+            } else if (data.human.status === 'unavailable') {
+              data.human = { status: 'unavailable', reason: data.human.reason };
+            } else data.human = { status: 'unavailable', reason: 'invalid_response' };
+          }
+          this.data = data;
+          retry = ['ready', 'finished', 'aborted'].includes(data.status)
+            ? 0
+            : data.status === 'pending'
+              ? 200
+              : 2000;
+        }
+      }
+    } catch {
+      if (this.request !== request || this.revision !== revision) return;
+      this.data = { game_id: gameId, revision, status: 'unavailable', source: 'engine' };
+    } finally {
+      clearTimeout(timeout);
+      if (this.request === request && this.revision === revision) {
+        this.redraw();
+        if (retry && !document.hidden) this.timer = setTimeout(() => void this.load(), retry);
+      }
+    }
+  }
+}
diff --git a/ui/round/tests/winProbability.test.ts b/ui/round/tests/winProbability.test.ts
new file mode 100644
index 0000000..16dc213
--- /dev/null
+++ b/ui/round/tests/winProbability.test.ts
@@ -0,0 +1,169 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { setImmediate } from 'node:timers/promises';
+
+import type { RoundData } from '../src/interfaces';
+import WinProbability, { validWdl, wdlPercentages, wdlRevision } from '../src/winProbability';
+
+const round = (moves: string[] = []): RoundData =>
+  ({
+    game: { id: 'test1234', status: { id: 20, name: 'started' } },
+    steps: [{ san: '' }, ...moves.map(san => ({ san }))],
+  }) as unknown as RoundData;
+
+const ready = (d: RoundData, white = 0.7): Response =>
+  new Response(
+    JSON.stringify({
+      game_id: d.game.id,
+      revision: wdlRevision(d),
+      status: 'ready',
+      source: 'engine',
+      probabilities: { white, draw: 0.2, black: 0.8 - white },
+    }),
+  );
+
+test('all rounded WDL values sum to exactly 100.0%', () => {
+  for (let white = 0; white <= 1; white += 0.017) {
+    for (let draw = 0; draw <= 1 - white; draw += 0.019) {
+      const values = wdlPercentages({ white, draw, black: 1 - white - draw });
+      assert.equal(Math.round(values.reduce((a, b) => a + b, 0) * 10), 1000);
+      assert.ok(values.every(v => v >= 0 && v <= 100));
+    }
+  }
+  assert.deepEqual(wdlPercentages({ white: 1, draw: 0, black: 0 }), [100, 0, 0]);
+});
+
+test('reject invalid and nonfinite probabilities', () => {
+  assert.equal(validWdl({ white: 0.3, draw: 0.3, black: 0.3 }), false);
+  assert.equal(validWdl({ white: NaN, draw: 0.5, black: 0.5 }), false);
+  assert.equal(validWdl({ white: 1.1, draw: 0, black: -0.1 }), false);
+  assert.equal(validWdl({ white: 0.6, draw: 0.3, black: 0.1 }), true);
+});
+
+test('invalid human probabilities are hidden while the valid engine result remains usable', async t => {
+  const d = round(['e4']);
+  const payload = await ready(d).json();
+  payload.human = { status: 'ready', model_id: 'pilot-v1', probabilities: { white: 2, draw: 0, black: -1 } };
+  t.mock.method(globalThis, 'fetch', async () => new Response(JSON.stringify(payload)));
+  const ctrl = new WinProbability(
+    () => d,
+    () => {},
+  );
+  t.after(ctrl.destroy);
+  await setImmediate();
+  assert.equal(ctrl.data?.status, 'ready');
+  assert.equal(ctrl.data?.probabilities?.white, 0.7);
+  assert.notEqual(ctrl.data?.human?.status, 'ready');
+  assert.equal(ctrl.data?.human?.probabilities, undefined);
+});
+
+test('late response cannot replace a different move at the same ply', async t => {
+  const responses: ((r: Response) => void)[] = [];
+  t.mock.method(globalThis, 'fetch', () => new Promise<Response>(resolve => responses.push(resolve)));
+  let d = round(['e4', 'e5']);
+  const previous = d;
+  const ctrl = new WinProbability(
+    () => d,
+    () => {},
+  );
+  t.after(ctrl.destroy);
+  d = round(['e4', 'c5']);
+  ctrl.sync();
+  responses[0](ready(previous));
+  await setImmediate();
+  assert.equal(ctrl.data, undefined);
+  responses[1](ready(d, 0.6));
+  await setImmediate();
+  assert.equal(ctrl.data?.probabilities?.white, 0.6);
+});
+
+test('a new move immediately clears the previous estimate', async t => {
+  const responses: ((r: Response) => void)[] = [];
+  t.mock.method(globalThis, 'fetch', () => new Promise<Response>(resolve => responses.push(resolve)));
+  let d = round(['e4']);
+  const ctrl = new WinProbability(
+    () => d,
+    () => {},
+  );
+  t.after(ctrl.destroy);
+  responses[0](ready(d));
+  await setImmediate();
+  assert.equal(ctrl.data?.status, 'ready');
+  d = round(['e4', 'e5']);
+  ctrl.sync();
+  assert.equal(ctrl.data, undefined);
+});
+
+test('official result takes precedence even when engine reply arrives later', async t => {
+  let respond!: (r: Response) => void;
+  t.mock.method(
+    globalThis,
+    'fetch',
+    () =>
+      new Promise<Response>(resolve => {
+        respond = resolve;
+      }),
+  );
+  const d = round(['e4']);
+  const oldReply = ready(d);
+  const ctrl = new WinProbability(
+    () => d,
+    () => {},
+  );
+  t.after(ctrl.destroy);
+  d.game.status = { id: 31, name: 'resign' };
+  d.game.winner = 'black';
+  ctrl.sync();
+  respond(oldReply);
+  await setImmediate();
+  assert.equal(ctrl.data?.source, 'official');
+  assert.deepEqual(ctrl.data?.probabilities, { white: 0, draw: 0, black: 1 });
+});
+
+test('aborted games have no invented result or engine request', t => {
+  const fetch = t.mock.method(globalThis, 'fetch');
+  const d = round();
+  d.game.status = { id: 25, name: 'aborted' };
+  const ctrl = new WinProbability(
+    () => d,
+    () => {},
+  );
+  t.after(ctrl.destroy);
+  assert.equal(ctrl.data?.status, 'aborted');
+  assert.equal(ctrl.data?.probabilities, undefined);
+  assert.equal(fetch.mock.callCount(), 0);
+});
+
+test('service failure shows unavailable without retaining numbers', async t => {
+  t.mock.method(globalThis, 'fetch', async () => {
+    throw new Error('offline');
+  });
+  const ctrl = new WinProbability(
+    () => round(),
+    () => {},
+  );
+  t.after(ctrl.destroy);
+  await setImmediate();
+  assert.equal(ctrl.data?.status, 'unavailable');
+  assert.equal(ctrl.data?.probabilities, undefined);
+});
+
+test('disconnect clears estimates and a reload resumes the same position', async t => {
+  const responses: ((r: Response) => void)[] = [];
+  t.mock.method(globalThis, 'fetch', () => new Promise<Response>(resolve => responses.push(resolve)));
+  const d = round(['e4']);
+  const ctrl = new WinProbability(
+    () => d,
+    () => {},
+  );
+  t.after(ctrl.destroy);
+  responses[0](ready(d));
+  await setImmediate();
+  ctrl.disconnected();
+  assert.equal(ctrl.data?.status, 'stale');
+  assert.equal(ctrl.data?.probabilities, undefined);
+  ctrl.sync();
+  responses[1](ready(d));
+  await setImmediate();
+  assert.equal(ctrl.data?.status, 'ready');
+});
diff --git a/ui/round/tests/winProbabilityView.test.ts b/ui/round/tests/winProbabilityView.test.ts
